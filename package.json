{
  "name": "glenheir",
  "version": "0.1.0",
  "private": true,
  "description": "Jeu mobile de gestion de distillerie de whisky.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkuhmel/glenheir.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && tsc --noEmit && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
